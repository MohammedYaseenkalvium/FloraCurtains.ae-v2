// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum CustomerType {
  B2C
  B2B
}

enum CompanyType {
  INTERIOR_FIRM
  HOTEL
  HOSPITAL
  GOVERNMENT
  CONTRACTOR
  REAL_ESTATE
  OTHER
}

enum ContactRole {
  OWNER
  MANAGER
  INTERIOR_DESIGNER
  PROCUREMENT
  SITE_ENGINEER
  OTHER
}

enum EnquiryStatus {
  NEW
  CONTACTED
  VISIT_SCHEDULED
  QUOTED
  NEGOTIATING
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  REVISED
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  INSTALLATION
  SNAGGING
  COMPLETED
  ON_HOLD
}

enum PaymentType {
  ADVANCE
  INSTALLMENT
  BALANCE
  RETENTION
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CHEQUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum CustomerSource {
  CALL
  WALK_IN
  REFERRAL
  INSTAGRAM
  WEBSITE
  WHATSAPP
  EXISTING_CLIENT
  TENDER
}

// ── Company ───────────────────────────────────────────────────────────────────

model Company {
  id           String      @id @default(cuid())
  tradeName    String      @unique
  legalName    String?
  type         CompanyType @default(OTHER)
  trn          String?
  address      String?
  website      String?
  creditTerms  Int         @default(0)
  notes        String?

  contacts     Contact[]
  enquiries    Enquiry[]
  projects     Project[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("companies")
}

// ── Contact ───────────────────────────────────────────────────────────────────

model Contact {
  id           String       @id @default(cuid())
  name         String
  phone        String       @unique
  email        String?
  whatsapp     String?
  role         ContactRole  @default(OTHER)
  source       CustomerSource @default(CALL)
  notes        String?

  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id])

  enquiries    Enquiry[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("contacts")
}

// ── Enquiry ───────────────────────────────────────────────────────────────────

model Enquiry {
  id             String         @id @default(cuid())
  contactId      String
  contact        Contact        @relation(fields: [contactId], references: [id])
  companyId      String?
  company        Company?       @relation(fields: [companyId], references: [id])
  customerType   CustomerType   @default(B2C)
  serviceWanted  String
  remarks        String?
  desiredBudget  Float?
  interestLevel  Int            @default(3)
  status         EnquiryStatus  @default(NEW)
  assignedTo     String?
  followUpDate   DateTime?
  projectName    String?
  siteAddress    String?

  quotations     Quotation[]
  project        Project?
  tasks          Task[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("enquiries")
}

// ── Quotation ─────────────────────────────────────────────────────────────────

model Quotation {
  id             String          @id @default(cuid())
  enquiryId      String
  enquiry        Enquiry         @relation(fields: [enquiryId], references: [id])
  quoteNumber    String          @unique
  items          Json
  subtotal       Float
  vatRate        Float           @default(5)
  vatAmount      Float
  totalAmount    Float
  status         QuotationStatus @default(DRAFT)
  validUntil     DateTime?
  billedToName   String?
  billedToTrn    String?
  billedToAddr   String?
  notes          String?
  internalNotes  String?
  project        Project?
  payments       Payment[]       // ← THIS IS ALREADY CORRECTLY PLACED
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("quotations")
}

// ── Project ───────────────────────────────────────────────────────────────────

model Project {
  id                 String        @id @default(cuid())
  enquiryId          String        @unique
  enquiry            Enquiry       @relation(fields: [enquiryId], references: [id])
  quotationId        String?       @unique
  quotation          Quotation?    @relation(fields: [quotationId], references: [id])
  poNumber           String?
  poDate             DateTime?
  companyId          String?
  company            Company?      @relation(fields: [companyId], references: [id])
  totalContractValue Float
  status             ProjectStatus @default(NOT_STARTED)
  startDate          DateTime?
  endDate            DateTime?
  installationDate   DateTime?
  siteAddress        String?
  notes              String?
  payments           Payment[]
  tasks              Task[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("projects")
}

// ── Payment ───────────────────────────────────────────────────────────────────

model Payment {
  id          String        @id @default(cuid())
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id])
  quotationId String?
  quotation   Quotation?    @relation(fields: [quotationId], references: [id])
  amount      Float
  type        PaymentType
  method      PaymentMethod @default(CASH)
  reference   String?
  paidAt      DateTime      @default(now())
  notes       String?
  createdAt   DateTime      @default(now())

  @@map("payments")
}

// ── Task ──────────────────────────────────────────────────────────────────────

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  enquiryId   String?
  enquiry     Enquiry?     @relation(fields: [enquiryId], references: [id])
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id])
  assignedTo  String?
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIUM)
  done        Boolean      @default(false)
  doneAt      DateTime?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("tasks")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
  name     String
  role     String @default("STAFF")
  createdAt DateTime @default(now())
  @@map("users")
}

model AppSettings {
  id            String   @id @default(cuid())
  companyName   String   @default("Flora Interior Operations")
  vatNumber     String   @default("100000000000003")
  currency      String   @default("AED")
  defaultVatRate Float   @default(5)
  quoteValidityDays Int  @default(30)
  logoUrl       String   @default("/images/logo.png")
  updatedAt     DateTime @updatedAt
  @@map("app_settings")
}