// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum ContactRole {
  PRIMARY
  SECONDARY
  OTHER
}

enum CustomerSource {
  CALL
  WHATSAPP
  EMAIL
  REFERRAL
  SOCIAL_MEDIA
  OTHER
}

enum CustomerType {
  B2C
  B2B
}

enum EnquiryStatus {
  NEW
  CONTACTED
  INTERESTED
  NOT_INTERESTED
  CONVERTED
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum PaymentType {
  ADVANCE
  PARTIAL
  FINAL
}

enum PaymentMethod {
  CASH
  CHEQUE
  TRANSFER
  CREDIT_CARD
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Models
model Company {
  id        String     @id @default(cuid())
  name      String     @unique
  trn       String?
  email     String?
  phone     String?
  address   String?
  notes     String?
  
  contacts  Contact[]
  enquiries Enquiry[]
  projects  Project[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("companies")
}

model Contact {
  id           String       @id @default(cuid())
  name         String
  phone        String       @unique
  email        String?
  whatsapp     String?
  role         ContactRole  @default(OTHER)
  source       CustomerSource @default(CALL)
  notes        String?

  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id])

  enquiries    Enquiry[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([companyId])
  @@map("contacts")
}

model Enquiry {
  id             String         @id @default(cuid())
  contactId      String
  contact        Contact        @relation(fields: [contactId], references: [id])
  companyId      String?
  company        Company?       @relation(fields: [companyId], references: [id])
  customerType   CustomerType   @default(B2C)
  serviceWanted  String
  remarks        String?
  desiredBudget  Float?
  interestLevel  Int            @default(3)
  status         EnquiryStatus  @default(NEW)
  assignedTo     String?
  followUpDate   DateTime?
  projectName    String?
  siteAddress    String?

  quotations     Quotation[]
  project        Project?
  tasks          Task[]

  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([deletedAt])
  @@index([contactId])
  @@index([companyId])
  @@map("enquiries")
}

model Quotation {
  id             String          @id @default(cuid())
  enquiryId      String
  enquiry        Enquiry         @relation(fields: [enquiryId], references: [id])
  quoteNumber    String          @unique
  items          Json
  subtotal       Float
  vatRate        Float           @default(5)
  vatAmount      Float
  totalAmount    Float
  status         QuotationStatus @default(DRAFT)
  validUntil     DateTime?
  billedToName   String?
  billedToTrn    String?
  billedToAddr   String?
  notes          String?
  internalNotes  String?
  project        Project?
  payments       Payment[]
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([deletedAt])
  @@index([enquiryId])
  @@map("quotations")
}

model Project {
  id                 String        @id @default(cuid())
  enquiryId          String        @unique
  enquiry            Enquiry       @relation(fields: [enquiryId], references: [id])
  quotationId        String?       @unique
  quotation          Quotation?    @relation(fields: [quotationId], references: [id])
  poNumber           String?
  poDate             DateTime?
  companyId          String?
  company            Company?      @relation(fields: [companyId], references: [id])
  totalContractValue Float
  status             ProjectStatus @default(NOT_STARTED)
  startDate          DateTime?
  endDate            DateTime?
  installationDate   DateTime?
  siteAddress        String?
  notes              String?
  payments           Payment[]
  tasks              Task[]

  createdById        String?
  updatedById        String?
  deletedAt          DateTime?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([deletedAt])
  @@index([companyId])
  @@map("projects")
}

model Payment {
  id          String        @id @default(cuid())
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id])
  quotationId String?
  quotation   Quotation?    @relation(fields: [quotationId], references: [id])
  amount      Float
  type        PaymentType
  method      PaymentMethod @default(CASH)
  reference   String?
  paidAt      DateTime      @default(now())
  notes       String?
  createdById String?
  createdAt   DateTime      @default(now())

  @@index([projectId])
  @@index([quotationId])
  @@map("payments")
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  enquiryId   String?
  enquiry     Enquiry?     @relation(fields: [enquiryId], references: [id])
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id])
  assignedTo  String?
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIUM)
  done        Boolean      @default(false)
  doneAt      DateTime?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([enquiryId])
  @@index([projectId])
  @@map("tasks")
}