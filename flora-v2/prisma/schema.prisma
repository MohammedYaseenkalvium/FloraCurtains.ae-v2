// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum CustomerType {
  B2C
  B2B
}

enum CompanyType {
  INTERIOR_FIRM
  HOTEL
  HOSPITAL
  GOVERNMENT
  CONTRACTOR
  REAL_ESTATE
  OTHER
}

enum ContactRole {
  OWNER
  MANAGER
  INTERIOR_DESIGNER
  PROCUREMENT
  SITE_ENGINEER
  OTHER
}

enum EnquiryStatus {
  NEW
  CONTACTED
  VISIT_SCHEDULED
  QUOTED
  NEGOTIATING
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  REVISED
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  INSTALLATION
  SNAGGING
  COMPLETED
  ON_HOLD
}

enum PaymentType {
  ADVANCE
  INSTALLMENT
  BALANCE
  RETENTION
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CHEQUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum CustomerSource {
  CALL
  WALK_IN
  REFERRAL
  INSTAGRAM
  WEBSITE
  WHATSAPP
  EXISTING_CLIENT
  TENDER
}

enum PaymentScheduleDueType {
  EXACT_DATE
  ON_APPROVAL
  BEFORE_PRODUCTION
  BEFORE_INSTALLATION
  ON_INSTALLATION
  ON_COMPLETION
}

enum PaymentScheduleStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum SiteVisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum MeasurementUnit {
  MM
  CM
  M
  FT
  IN
}

// ── Company ───────────────────────────────────────────────────────────────────

model Company {
  id          String      @id @default(cuid())
  tradeName   String      @unique
  legalName   String?
  type        CompanyType @default(OTHER)
  trn         String?
  address     String?
  website     String?
  creditTerms Int         @default(0)
  notes       String?

  contacts  Contact[]
  enquiries Enquiry[]
  projects  Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

// ── Contact ───────────────────────────────────────────────────────────────────

model Contact {
  id       String         @id @default(cuid())
  name     String
  phone    String         @unique
  email    String?
  whatsapp String?
  role     ContactRole    @default(OTHER)
  source   CustomerSource @default(CALL)
  notes    String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  enquiries Enquiry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contacts")
}

// ── Enquiry ───────────────────────────────────────────────────────────────────

model Enquiry {
  id            String        @id @default(cuid())
  contactId     String
  contact       Contact       @relation(fields: [contactId], references: [id])
  companyId     String?
  company       Company?      @relation(fields: [companyId], references: [id])
  customerType  CustomerType  @default(B2C)
  serviceWanted String
  remarks       String?
  desiredBudget Float?
  interestLevel Int           @default(3)
  status        EnquiryStatus @default(NEW)
  assignedTo    String?
  followUpDate  DateTime?
  projectName   String?
  siteAddress   String?

  quotations Quotation[]
  project    Project?
  tasks      Task[]
  siteVisits SiteVisit[]

  createdById String?
  updatedById String?
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@map("enquiries")
}

// ── Quotation ─────────────────────────────────────────────────────────────────

model Quotation {
  id            String          @id @default(cuid())
  enquiryId     String
  enquiry       Enquiry         @relation(fields: [enquiryId], references: [id])
  quoteNumber   String          @unique
  items         Json
  subtotal      Float
  vatRate       Float           @default(5)
  vatAmount     Float
  totalAmount   Float
  status        QuotationStatus @default(DRAFT)
  validUntil    DateTime?
  billedToName  String?
  billedToTrn   String?
  billedToAddr  String?
  notes         String?
  internalNotes String?
  project       Project?
  payments      Payment[]
  createdById   String?
  updatedById   String?
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([deletedAt])
  @@map("quotations")
}

// ── Project ───────────────────────────────────────────────────────────────────

model Project {
  id        String  @id @default(cuid())
  enquiryId String  @unique
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id])

  quotationId String?    @unique
  quotation   Quotation? @relation(fields: [quotationId], references: [id])

  poNumber String?
  poDate   DateTime?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  totalContractValue Float
  status             ProjectStatus @default(NOT_STARTED)

  startDate        DateTime?
  endDate          DateTime?
  installationDate DateTime?
  siteAddress      String?
  notes            String?

  payments         Payment[]
  paymentSchedules PaymentSchedule[]
  tasks            Task[]
  siteVisits       SiteVisit[]

  createdById String?
  updatedById String?
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@map("projects")
}

// ── Payment ───────────────────────────────────────────────────────────────────

model Payment {
  id          String        @id @default(cuid())
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id])
  quotationId String?
  quotation   Quotation?    @relation(fields: [quotationId], references: [id])
  amount      Float
  type        PaymentType
  method      PaymentMethod @default(CASH)
  reference   String?
  paidAt      DateTime      @default(now())
  notes       String?
  createdById String?
  createdAt   DateTime      @default(now())

  @@map("payments")
}

// PaymentSchedule
model PaymentSchedule {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sequence    Int
  description String

  // Optional percentage used when the schedule was created.
  // The actual amount is stored separately as a snapshot.
  percentage Float?

  // Actual amount expected for this milestone.
  amount Float

  dueType PaymentScheduleDueType
  dueDate DateTime?

  status PaymentScheduleStatus @default(PENDING)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, sequence])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@map("payment_schedules")
}

// ── Site Visit ────────────────────────────────────────────────────────────────

model SiteVisit {
  id String @id @default(cuid())

  enquiryId String
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  scheduledAt DateTime?
  completedAt DateTime?

  assignedTo String?

  status SiteVisitStatus @default(SCHEDULED)

  siteAddress String?
  notes       String?

  measurements MeasurementSheet[]
  attachments  SiteVisitAttachment[]

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enquiryId])
  @@index([projectId])
  @@index([status])
  @@index([scheduledAt])
  @@map("site_visits")
}

// ── Measurement Sheet ─────────────────────────────────────────────────────────

model MeasurementSheet {
  id String @id @default(cuid())

  siteVisitId String
  siteVisit   SiteVisit @relation(fields: [siteVisitId], references: [id], onDelete: Cascade)

  roomName    String
  openingName String?
  openingType String?

  width  Float
  height Float

  unit MeasurementUnit @default(MM)

  quantity Int @default(1)

  curtainType String?
  trackType   String?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteVisitId])
  @@map("measurement_sheets")
}

// ── Site Visit Attachment ─────────────────────────────────────────────────────

model SiteVisitAttachment {
  id String @id @default(cuid())

  siteVisitId String
  siteVisit   SiteVisit @relation(fields: [siteVisitId], references: [id], onDelete: Cascade)

  fileName String
  fileUrl  String

  fileType String
  mimeType String?

  caption String?

  uploadedById String?

  createdAt DateTime @default(now())

  @@index([siteVisitId])
  @@map("site_visit_attachments")
}

// ── Task ──────────────────────────────────────────────────────────────────────

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  enquiryId   String?
  enquiry     Enquiry?     @relation(fields: [enquiryId], references: [id])
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id])
  assignedTo  String?
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIUM)
  done        Boolean      @default(false)
  doneAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("STAFF")
  createdAt DateTime @default(now())

  @@map("users")
}

model AppSettings {
  id                String   @id @default(cuid())
  companyName       String   @default("Flora Interior Operations")
  vatNumber         String   @default("100000000000003")
  currency          String   @default("AED")
  defaultVatRate    Float    @default(5)
  quoteValidityDays Int      @default(30)
  logoUrl           String   @default("/images/logo.png")
  updatedAt         DateTime @updatedAt

  @@map("app_settings")
}

// ── ActivityLog ─────────────────────────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  action     String // e.g. "CREATE", "UPDATE", "DELETE", "STATUS_CHANGE"
  entityType String // e.g. "Enquiry", "Quotation", "Project", "Payment", "Task"
  entityId   String?
  summary    String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}
